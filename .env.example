# Copia este archivo como .env y ajusta los valores (docker compose lo lee solo).

# Cámara del Edge: 0 = cámara USB (Linux + docker-compose.hardware.yml)
# o la URL de la cámara del celular (app IP Webcam), que sí funciona en Windows:
CAMARA=0
# CAMARA=http://192.168.1.15:8080/video

# Arduino: none = simulado. Con docker-compose.hardware.yml se ignora (usa /dev/ttyACM0)
PUERTO_ARDUINO=none
# Dispositivos del host (solo docker-compose.hardware.yml)
CAMARA_DEV=/dev/video0
ARDUINO_DEV=/dev/ttyACM0

# Segundos sin actividad antes de apagar la luz
TIMEOUT_SEG=15

# Modelo de energía del Fog
P_BOMBILLO_W=9.0
P_ESPERA_W=0.4
OLVIDO_MAX_H_DIA=4.0
